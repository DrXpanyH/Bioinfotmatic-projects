import pysam # For reading BAM files
from pyensembl import EnsemblRelease # For finding exon coordinates
import pandas as pd # For writing the report as a CSV file
import numpy as np
import subprocess
import matplotlib.pyplot as plt

def gene_coverage(bam='', gene='', transcript=''):
    # Gene info
    data = EnsemblRelease(115)
    gene = data.genes_by_name(gene)[0]
    transcript = data.transcript_by_id(transcript)
    print(f"Gene name: {gene.gene_name}")
    print(f"Gene ID: {gene.gene_id}")
    print(f"Location: Chromosome {gene.contig}: {gene.start} - {gene.end}")
    print(f'Transcript ID: {transcript.transcript_id}') 

    start = gene.start
    end = gene.end
    chrom = gene.contig
    total_bases = end - start
    location = f"{chrom}:{start}-{end}"

    # Dictionary for report:
    report = {
        'Gene name': [gene.gene_name],
        'Gene ID': [gene.gene_id],
        'Location': [f"{gene.contig}: {gene.start} - {gene.end}"],
        'Transcript ID': [transcript.transcript_id],
        'Total reads': [],
        'Mean coverage': []
    }

    with pysam.AlignmentFile(bam, 'rb') as content:
        # Count total reads
        total = content.count(chrom, start, end)
        report['Total reads'].append(total)

        # Using subprocess to run samtools
        terminal = ['samtools', 'depth', '-a', '-r', location, bam] # Samtools computes the read depth
        sam_out = subprocess.run(terminal, capture_output=True, text=True, check=True)
        positions_depths = np.loadtxt(sam_out.stdout.strip().splitlines(), dtype=int, usecols=(1,2)) # np.loadtxt instead of a loop. Return positions and depths
        positions = positions_depths[:,0]
        depths = positions_depths[:,1]

        # Count mean coverage
        mean_coverage = np.mean(depths)
        report['Mean coverage'].append(mean_coverage)

        count_zero = np.sum(depths == 0)
        report['Bases with 0x coverage'] = [f'{count_zero} ({(count_zero/total_bases)*100:.3f}%)']

        bins = [0, 6, 11, 21, 50]
        sum_positions, bin_edges = np.histogram(depths, bins)
        for i in range(len(sum_positions)):
            report[f'Bases with {bins[i]}-{bins[i+1]-1}x coverage'] = [f'{sum_positions[i]} ({(sum_positions[i]/total_bases)*100:.3f}%)']

        count_51 = np.sum(depths > 50) 
        report['Bases with >50x coverage'] = [f'{count_51} ({(count_51/total_bases)*100:.3f}%)']

        count_10 = np.sum(depths >= 10)
        count_10_percent = (count_10/total_bases)*100
        report['Bases with ≥10x coverage'] = [f'{count_10} ({count_10_percent:.3f}%)']
        if count_10_percent >= 95:
            report['QC Verdict'] = ['PASS']
            print('QC Verdict: PASS (≥95% bases at ≥10x coverage)')
        elif count_10_percent > 80:
            report['QC Verdict'] = ['WARNING']
            print('QC Verdict: WARNING')
        else:
            report['QC Verdict'] = ['FAIL']
            print('QC Verdict: FAIL')

        # Plot data
        y1 = [mean_coverage for i in range(len(depths))]
        plt.figure(figsize=(16, 5), dpi=300)
        plt.plot(positions, depths, linewidth=0.1)
        plt.fill_between(positions, depths, alpha=0.5)
        plt.plot(positions, y1)
        for exon in transcript.exons:
            xmin = exon.start
            xmax = exon.end
            plt.axvspan(xmin=xmin, xmax=xmax, ymin=0, ymax=70, alpha=0.2)
        plt.title('Coverage')
        plt.xlabel('Position')
        plt.ylabel('Coverage')
        plt.xticks(positions[::30000])
        plt.savefig(f'{gene.gene_name} coverage plot.png')

        output = pd.DataFrame({key: pd.Series(value) for key, value in report.items()})
        output.to_csv(f"{gene.gene_name} QC report.csv", index=False, encoding='utf-8-sig', sep=';')

        print('Finish')

gene_coverage('https://ftp.ncbi.nlm.nih.gov/ReferenceSamples/giab/data/NA12878/NIST_NA12878_HG001_HiSeq_300x/RMNISTHS_30xdownsample.bam', 'SCN1A','ENST00000674923')
