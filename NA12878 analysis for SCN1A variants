import pysam # For reading vcf.gz
from pyensembl import EnsemblRelease # For finding exon coordinates
import pandas as pd # For writing the report as a CSV file

def vcf_info(vcf='', version=None, samples=None, contigs=None, info=None):
    vcf_file = pysam.VariantFile(vcf, 'r')
    header = vcf_file.header
    if version:
        print(f"Version: {header.version}\n")
    if samples:
        print(f"Samples: {list(header.samples)}\n")
    if contigs:
        print(f"Contigs: {list(header.contigs)}\n")
    if info:
        print(f"Info: {list(header.info)}")

def find_variants(vcf='', gene='', transcript='', sample='', tuple=tuple()):
    # Finding exon coordinates:
    data = EnsemblRelease(115)
    gene = data.genes_by_name(gene)[0] # Returns the first one found
    print(f"Gene name: {gene.gene_name}")
    print(f"Gene ID: {gene.gene_id}")
    print(f"Location: Chromosome {gene.contig}: {gene.start} - {gene.end}")
    transcript = data.transcript_by_id(transcript)
    print(f'Transcript ID: {transcript.transcript_id}')

    # Dictionary for report:
    data = {
        'Location': [],
        'Position': [],
        'REF': [],
        'ALT': [],
        'Genotype': [],
        'Homozygous Reference': [],
        'Heterozygous': [],
        'Homozygous Alternate': []
    }

    with pysam.VariantFile(vcf, "r") as vcf_file:
        print(list(vcf_file.header.samples))

        count_norm = 0 # Homozygous Reference (0/0)
        count_hetero = 0 # Heterozygous (0/1)
        count_alt = 0 # Homozygous Alternate (1/1)

        # Gene position:
        start_pos = gene.start
        end_pos = gene.end
        chrom = f'chr{gene.contig}'

        found_any = False
        for record in vcf_file.fetch(chrom, start_pos, end_pos):
            # Extract genotypes:
            sample_data = record.samples[sample]
            gt_tuple = sample_data["GT"]
            # Calculating variants:
            if gt_tuple == (0,0):
                count_norm+=1
            elif gt_tuple == (0,1):
                count_hetero+=1
            elif gt_tuple == (1,1):
                count_alt+=1

            if gt_tuple != tuple:
                continue
            # Distribution of variants
            location = False
            for exon in transcript.exons:
                if exon.start <= record.pos <= exon.end:
                    data['Location'].append('Exon')
                    location = True
                    found_any = True
                    print(f'Variant ({record.pos}) found in Exon {exon.exon_id}')
                elif exon.end < record.pos <= exon.end+2: # Variants in donor site (5' end of the intron)
                    data['Location'].append('Donor splice site')
                    location = True
                    found_any = True
                    print(f'Variant ({record.pos}) found in Splice site after {exon.exon_id}')
                elif exon.start-2 <= record.pos < exon.start: # Variants in acceptor site (3' end of the intron)
                    data['Location'].append('Acceptor splice site')
                    location = True
                    found_any = True
                    print(f'Variant ({record.pos}) found in Splice site before {exon.exon_id}')
            if not location:
                data['Location'].append('Intron')
            data['Position'].append(record.pos)
            data['REF'].append(record.ref)
            data['ALT'].append(record.alts if record.alts is not None else ())
            data['Genotype'].append(gt_tuple)
        if not found_any:
            print('Variants not found in the exons or splice sites')
        total_count = count_norm + count_hetero + count_alt
        data['Homozygous Reference'] = f'{int(count_norm)} ({count_norm/total_count*100:.2f}%)'
        data['Heterozygous'] = f'{int(count_hetero)} ({count_hetero/total_count*100:.2f}%)'
        data['Homozygous Alternate'] = f'{int(count_alt)} ({count_alt/total_count*100:.2f}%)'

        print(f"Homozygous Reference (0/0): {count_norm} ({count_norm/total_count*100:.2f}%)")
        print(f"Heterozygous (0/1): {count_hetero} ({count_hetero/total_count*100:.2f}%)")
        print(f"Homozygous Alternate (1/1): {count_alt} ({count_alt/total_count*100:.2f}%)")                        

        # Create DataFrame and export
        output = pd.DataFrame({key: pd.Series(value) for key, value in data.items()})
        output.to_csv(f"{gene.gene_name} variants.csv", index=False, encoding='utf-8-sig', sep=';')

vcf_info('BioProj_Lin/Files/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz', version=True)
find_variants('BioProj_Lin/Files/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz', 'SCN1A', 'ENST00000674923', 'HG001', (0,1))

