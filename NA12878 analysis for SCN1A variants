import pysam # For reading vcf.gz
from pyensembl import EnsemblRelease # For finding exon coordinates
import pandas as pd # For writing the report as a CSV file

# Finding exon coordinates:
data = EnsemblRelease(115)
gene = data.genes_by_name('SCN1A')[0] # Returns the first one found
print(f"Gene name: {gene.gene_name}")
print(f"Gene ID: {gene.gene_id}")
print(f"Location: Chromosome {gene.contig}: {gene.start} - {gene.end}")
transcript = data.transcript_by_id('ENST00000674923')
print(f'Transcript ID: {transcript.transcript_id}')

# Dictionary for report:
data = {
    'Chromosome': [],
    'Position': [],
    'REF': [],
    'ALT': [],
    'Genotype': [],
    'Heterozygous In Exons': [],
    'Heterozygous In Splice sites': [],
    'Heterozygous In Introns': [],
    'Homozygous Reference': [],
    'Heterozygous': [],
    'Homozygous Alternate': []
}

with pysam.VariantFile("/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz", "r") as vcf_file:
    print(list(vcf_file.header.samples))

    count_norm = 0 # Homozygous Reference (0/0)
    count_hetero = 0 # Heterozygous (0/1)
    count_alt = 0 # Homozygous Alternate (1/1)

    # Location SCN1A gene (Transcript: ENST00000674923.1):
    start_pos = gene.start
    end_pos = gene.end
    chrom = 'chr2'
    heterozygous_variants = []

    for record in vcf_file.fetch(chrom, start_pos, end_pos):
        # Extract genotypes:
        sample_data = record.samples['HG001']
        gt_tuple = sample_data["GT"]
        if gt_tuple == (0,1):
            data['Chromosome'].append(record.chrom)
            data['Position'].append(record.pos)
            data['REF'].append(record.ref)
            data['ALT'].append(record.alts)
            data['Genotype'].append(gt_tuple)
            # Distribution of heterozygous variants by exons
            found_any = False
            for exon in transcript.exons:
                if exon.start <= record.pos <= exon.end:
                    data['Heterozygous In Exons'].append(record.pos)
                    found_any = True
                    print(f'Variant ({record.pos}) found in Exon {exon.exon_id}')
                if exon.end < record.pos <= exon.end+2: # Variants in donor site (5' end of the intron)
                    data['Heterozygous In Splice sites'].append(record.pos)
                    found_any = True
                    print(f'Variant ({record.pos}) found in Splice site after {exon.exon_id}')
                if exon.start-2 <= record.pos < exon.start: # Variants in acceptor site (3' end of the intron)
                    data['Heterozygous In Splice sites'].append(record.pos)
                    found_any = True
                    print(f'Variant ({record.pos}) found in Splice site before {exon.exon_id}')
            if not found_any:
                data['Heterozygous In Introns'].append(record.pos)
                print('Variants not found in the exons or splice sites')
            print(f"{record.chrom}, Position: {record.pos}, Proband: {gt_tuple}") # Print Heterozygous Variants
        # Calculating variants:
        if gt_tuple == (0,0):
            count_norm+=1
        elif gt_tuple == (0,1):
            count_hetero+=1
        elif gt_tuple == (1,1):
            count_alt+=1
        total_count = count_norm+count_hetero+count_alt
        data['Homozygous Reference'] = count_norm
        data['Heterozygous'] = count_hetero
        data['Homozygous Alternate'] = count_alt

    # Distribution of variants by exons
    found_any = False
    for exon in transcript.exons:
        for variant in heterozygous_variants:
            if exon.start<=variant<=exon.end:
                print(f'Variant ({variant}) found in Exon {exon.exon_id}')
                found_any = True
            if exon.end < variant <= exon.end+2: # Variants in donor site (5' end of the intron)
                print(f'Variant ({variant}) found in Splicing site after {exon.exon_id}')
                found_any = True
            if exon.start-2 <= variant < exon.start: # Variants in acceptor site (3' end of the intron)
                print(f'Variant ({variant}) found in Splicing site before {exon.exon_id}')
                found_any = True
    if not found_any:
        print('Variants not found in the exons or splicing sites')
            
    print(f"Homozygous Reference (0/0): {count_norm} ({count_norm/total_count*100:.2f}%)")
    print(f"Heterozygous (0/1):        {count_hetero} ({count_hetero/total_count*100:.2f}%)")
    print(f"Homozygous Alternate (1/1): {count_alt} ({count_alt/total_count*100:.2f}%)")

    # Create DataFrame and export
    output = pd.DataFrame({key: pd.Series(value) for key, value in data.items()})
    output.to_csv("SCN1A variants.csv", index=False, encoding='utf-8-sig', sep=';')

